# ==============================================================================
# WatchParty - Production Environment Template (.env.production.example)
# Copy this file to .env on your production VPS and populate real secrets.
# Strict schema validation will fail fast on startup if secrets are missing.
# ==============================================================================

NODE_ENV=production
PORT=3001

# Public Canonical URL (Must match your registered domain)
DOMAIN=watchparty.example.com
BASE_URL=https://watchparty.example.com
ACME_EMAIL=admin@example.com
NODE_ID=node_vps_1

# Persistent Storage Mount
DATA_DIR=/data

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
POSTGRES_USER=watchparty
# Generate with: openssl rand -base64 24 | tr -dc 'a-zA-Z0-9'
POSTGRES_PASSWORD=generate_a_strong_db_password_here_12345
POSTGRES_DB=watchparty_db

# Connection string used by WatchParty app container
DATABASE_URL=postgresql://watchparty:generate_a_strong_db_password_here_12345@postgres:5432/watchparty_db

# ==============================================================================
# CACHE & CLUSTER PUB/SUB (Redis)
# ==============================================================================
REDIS_URL=redis://redis:6379

# ==============================================================================
# SECURITY & CRYPTOGRAPHY (MANDATORY IN PRODUCTION)
# ==============================================================================
# JWT Access Token Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_cryptographically_secure_random_jwt_secret_min_32_chars

# AES-256-GCM Field Encryption Key (Generate with: openssl rand -hex 32)
ENCRYPTION_KEY=replace_with_a_64_character_hex_encryption_key_here_0123456789abcdef

# Previous keys for zero-downtime rotation (comma-separated, optional)
ENCRYPTION_KEY_FALLBACKS=

# CORS Allowed Origins
CORS_ORIGIN=https://watchparty.example.com

# ==============================================================================
# TRANSACTIONAL EMAIL (Resend or Postmark)
# See docs/EMAIL_DELIVERABILITY.md for SPF, DKIM, and DMARC DNS records
# ==============================================================================
MAILER_PROVIDER=resend
RESEND_API_KEY=re_your_real_resend_api_key_here
MAIL_FROM="WatchParty" <no-reply@watchparty.example.com>

# If using Postmark instead:
# MAILER_PROVIDER=postmark
# POSTMARK_SERVER_TOKEN=your-postmark-server-token

# ==============================================================================
# WEB PUSH NOTIFICATIONS (RFC 8292 VAPID)
# Generate keypair via: npx web-push generate-vapid-keys
# ==============================================================================
VAPID_PUBLIC_KEY=replace_with_your_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_your_vapid_private_key
VAPID_CONTACT_EMAIL=mailto:admin@watchparty.example.com

# ==============================================================================
# ADMIN DASHBOARD & ACCESS CONTROL
# ==============================================================================
# High-entropy admin password/token for /admin dashboard (Generate with: openssl rand -hex 24)
ADMIN_SECRET=replace_with_a_secure_admin_secret_at_least_16_chars_1234567890

# Registration Mode: "invite_only" | "public" | "disabled" (kill switch)
REGISTRATION_MODE=invite_only

# Optional shared master invite code for initial friend group rollouts
REGISTRATION_INVITE_CODE=WATCHPARTY2026

# ==============================================================================
# OBSERVABILITY, ERROR TRACKING & COST ALERTS (SENTRY FREE TIER)
# ==============================================================================
# Sentry DSN from sentry.io (Free tier: 5k errors/month)
SENTRY_DSN=
CLIENT_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Uptime webhook for phone alerts (Better Stack, Telegram Bot, Discord, Pushover)
UPTIME_ALERT_WEBHOOK_URL=
USAGE_ALERT_EMAIL=admin@watchparty.example.com

# ==============================================================================
# CONTAINER IMAGE FOR CI/CD
# ==============================================================================
APP_IMAGE=ghcr.io/yourusername/watchparty:latest

