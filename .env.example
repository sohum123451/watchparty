# ==============================================================================
# Watch Party - Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# Copy this file to .env and fill in production secrets.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
# In production, strict HTTPS redirection and secure cookie flags are strictly enforced.
NODE_ENV=production

# Server Port and Public Canonical Base URL
PORT=3001
BASE_URL=https://watchparty.example.com

# Node Identifier for Multi-Node Cluster Ownership & Distributed Tracing
NODE_ID=node_1

# ==============================================================================
# REDIS PERSISTENCE & MULTI-NODE CLUSTER PUB/SUB
# ==============================================================================

# Redis Connection URL (e.g. redis://localhost:6379 or rediss://... with TLS)
# Used for room state snapshots (restart recovery), distributed locks, and pub/sub
# If omitted, automatically falls back to high-performance In-Memory Redis.
REDIS_URL=redis://localhost:6379

# ==============================================================================
# TRANSPORT & STORAGE SECURITY
# ==============================================================================

# CORS Allowed Origins
# Comma-separated list of exact origins permitted to establish cross-origin requests
# with credentials. Wildcards ('*') are strictly disallowed when credentials are true.
CORS_ORIGIN=https://watchparty.example.com,https://app.watchparty.example.com

# Primary Field-Level Encryption Key (AES-256-GCM)
# 256-bit key formatted as 64 hex characters or 44 base64 characters.
# Used for encrypting PII, verification tokens, and sensitive fields at rest.
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Fallback Encryption Keys (Key Rotation)
# Comma-separated list of previous encryption keys. When decrypting, if the primary key fails,
# the service attempts fallback keys in sequence, allowing zero-downtime rotation.
# When a record is rewritten, it will be re-encrypted with the primary key.
ENCRYPTION_KEY_FALLBACKS=

# JWT Secret Key for Access Tokens
# Must be at least 32 characters of high-entropy randomness.
# Generate via: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# ==============================================================================
# REAL-TIME MEDIA PLANE (LiveKit SFU & WebRTC TURN/STUN)
# ==============================================================================

# Media Provider ('livekit' | 'mock')
MEDIA_PROVIDER=livekit

# LiveKit SFU Server URL and API Credentials (Self-hosted or LiveKit Cloud)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional Coturn TURN server fallback for restrictive symmetric NATs and mobile carriers
# Supports RFC 5766 time-limited HMAC credentials or static auth
COTURN_URL=turn:localhost:3478?transport=udp
COTURN_SECRET=coturn_shared_secret_key_change_in_production
# COTURN_USERNAME=watchparty
# COTURN_CREDENTIAL=turn_password

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================

DATABASE_URL=postgresql://watchparty:watchparty_secret@localhost:5432/watchparty_db?sslmode=prefer

# ==============================================================================
# EMAIL SERVICE (Verification & Password Reset)
# ==============================================================================

# Mailer Provider: 'smtp' | 'resend' | 'console'
MAILER_PROVIDER=smtp

# SMTP Configuration (when MAILER_PROVIDER=smtp)
# For local development with docker-compose Mailpit:
# SMTP_HOST=localhost, SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Watch Party Security" <no-reply@watchparty.example.com>

# Resend API Key (when MAILER_PROVIDER=resend)
RESEND_API_KEY=re_your_api_key_here

# ==============================================================================
# OBSERVABILITY & AUDIT
# ==============================================================================

# Maximum in-memory security audit log buffer size
AUDIT_LOG_MAX_ENTRIES=5000

# Prometheus metrics are exposed at /metrics (OpenMetrics format)
# Health probe: /health
# Readiness probe: /ready
# Dashboard: /dashboard
# Grafana export: /api/metrics/dashboard.json
