# ==============================================================================
# WatchParty - Local Development Environment Configuration (.env.development)
# Zero-config safe defaults for local development and offline testing
# ==============================================================================

NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
NODE_ID=node_local_dev

# Database & Cache (Matches docker-compose.yml services)
DATABASE_URL=postgresql://watchparty:watchparty_secret@localhost:5432/watchparty_db
REDIS_URL=redis://localhost:6379
DATA_DIR=./.data

# Development Cryptography & Auth Secrets
JWT_SECRET=development_jwt_secret_key_at_least_32_characters_12345
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Transactional Email (Console outputs verification & reset links to terminal)
MAILER_PROVIDER=console
MAIL_FROM="WatchParty Local" <no-reply@watchparty.internal>

# Web Push Notifications (Auto-generates VAPID keys if omitted)
VAPID_CONTACT_EMAIL=mailto:dev@watchparty.internal

# Admin Dashboard & Registration Access Control
ADMIN_SECRET=dev-admin-secret-password-16chars
REGISTRATION_MODE=invite_only
REGISTRATION_INVITE_CODE=WATCHFRIENDS2026

# Observability & Sentry Error Tracking (Optional)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# CLIENT_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# UPTIME_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

