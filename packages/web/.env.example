# ──────────────────────────────────────────────────────────────────────────────
# Watch Party – Frontend environment variables (.env.local / Vercel)
# Copy to packages/web/.env.local for local dev.
# Add all NEXT_PUBLIC_* vars to Vercel → Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────────────────────

# --------------- Required on Vercel (production) ---------------

# REST API base URL – used by Next.js rewrites in next.config.mjs
# Points to your EC2 Caddy server (HTTPS).
API_BACKEND_URL=https://api.watchparty.example.com

# WebSocket base URL (wss://) – used by useRoomSocket on the client.
# Must NOT end with /; the hook appends nothing to it.
NEXT_PUBLIC_WS_URL=wss://api.watchparty.example.com

# REST API base URL exposed to the browser (for client-side fetch).
# If you proxy all /api/* through Next.js rewrites, you can omit this.
NEXT_PUBLIC_API_URL=https://api.watchparty.example.com

# --------------- Optional ---------------

# Google OAuth client ID for the Google Sign-In button.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Sentry DSN for client-side error tracking.
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# --------------- Local development defaults ---------------
# Override in packages/web/.env.local (never commit secrets):
#   API_BACKEND_URL=http://localhost:3001
#   NEXT_PUBLIC_WS_URL=ws://localhost:3001
#   NEXT_PUBLIC_API_URL=http://localhost:3001
